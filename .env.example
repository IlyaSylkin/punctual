# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# Postgres — GTFS static: маршруты, остановки, расписание
POSTGRES_DB=punctual
POSTGRES_USER=punctual
POSTGRES_PASSWORD=change_me

# ClickHouse — позиции, изменения прогнозов, факты, ошибки
CLICKHOUSE_DB=punctual
CLICKHOUSE_USER=punctual
CLICKHOUSE_PASSWORD=change_me
